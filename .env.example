# Copy to .env (untracked) to run the validation tests against local game files.
# Extracted FIFA 07 US folder (contains SLUS_214.33 and EACN/BIN/EA_DASH.ELF):
TEST_PS2_DIR=C:/Games/PS2/FIFA Soccer 07 (USA) (En,Es)
# A FIFA 07 US .iso for the end-to-end ISO walker test:
TEST_PS2_ISO=C:/Games/PS2/FIFA Soccer 07 (USA) (En,Es).iso
# Extracted Sims Bustin' Out US folder (contains SLUS_208.42) for the older
# DirtyDnas-engine DNAS detector test:
TEST_SIMS_DIR=C:/Games/PS2/Sims, The - Bustin' Out (USA)
# Burnout 3: Takedown US ISO(s) for the Sony DNAS 2.x embedded-module detector.
# ORIG is scanned; if PATCHED is set too, the detector output is checked
# byte-for-byte against the real DNAS_PATCHER21 patched image:
TEST_BURNOUT_ISO=C:/Games/PS2/Burnout 3 - Takedown (USA, Canada).iso
TEST_BURNOUT_ISO_PATCHED=C:/Games/PS2/Burnout 3 - Takedown (USA, Canada) PATCHED.iso
# Optional: Burnout Revenge (DNAS300) to prove the detector generalises. The
# accessor hides in a TERF container triage can't see, so this runs a full-image
# scan (slow ~40 s). Leave unset to skip.
TEST_REVENGE_ISO=C:/Games/PS2/Burnout Revenge (USA, Canada).iso
